# Copy to .env (git-ignored) and edit for anything real.
# These local-dev defaults mirror mise.toml [env]; compose reads them too.

POSTGRES_USER=tourdesk
POSTGRES_PASSWORD=tourdesk
POSTGRES_DB=tourdesk
POSTGRES_PORT=5433

NATS_PORT=4222
NATS_MONITOR_PORT=8222

TIKA_PORT=9998
CLAMAV_PORT=3310

DATABASE_URL=postgres://tourdesk:tourdesk@localhost:5433/tourdesk?sslmode=disable
# Non-superuser app role — tenant-scoped access is bound by RLS (ADR-0015).
# Created by migration 0001; superuser DATABASE_URL is for migrations/seeding only.
APP_DATABASE_URL=postgres://tourdesk_app:tourdesk_app@localhost:5433/tourdesk?sslmode=disable
NATS_URL=nats://localhost:4222
TIKA_URL=http://localhost:9998
CLAMAV_ADDR=localhost:3310

# LLM provider — the only external dependency (ADR-0028). EU-resident, no-training.
# Provider-agnostic Messages-API-compatible client (ADR-0010). Base URL is the API
# root; models are pinned per env, never "latest" (MOD-06); verify != generate (MOD-03).
# LLM_API_BASE=https://<eu-resident-endpoint>/v1
# LLM_API_KEY=
# LLM_MODEL_CLASSIFY=
# LLM_MODEL_GENERATE=
# LLM_MODEL_VERIFY=
